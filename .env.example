# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore y NUNCA debe commitearse (SRS T-101).
# No pegues estos valores en un chat, un issue ni un PR.

# --- Resend (Fase 2: formulario de contacto) ---
# Clave de API de Resend. Solo servidor, jamás con prefijo NEXT_PUBLIC_.
RESEND_API_KEY=

# Remitente verificado en Resend. Con dominio propio va algo como
# `contacto@tudominio.com`; mientras no lo haya, Resend permite enviar desde
# `onboarding@resend.dev`, que SOLO entrega a la dirección dueña de la cuenta:
# sirve para este formulario porque CONTACT_TO_EMAIL es esa misma dirección.
CONTACT_FROM_EMAIL=

# Bandeja de destino de los mensajes del formulario.
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile (Fase 2) ---
# Site key: es pública por diseño (se renderiza en el cliente).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key: solo servidor. Valida el token contra Cloudflare.
TURNSTILE_SECRET_KEY=
